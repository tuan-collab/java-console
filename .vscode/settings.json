{
  "java.debug.settings.vmArgs": "-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8",
  "terminal.integrated.defaultProfile.windows": "PowerShell UTF8",
  "terminal.integrated.profiles.windows": {
    "PowerShell UTF8": {
      "source": "PowerShell",
      "args": ["-NoExit", "-Command", "chcp 65001 > $null; [Console]::OutputEncoding = [System.Text.Encoding]::UTF8; [Console]::InputEncoding = [System.Text.Encoding]::UTF8"]
    }
  }
}
